{
  "name": "Library Analytics - Data Bookworms",
  "dataColors": [
    "#1F4E79",
    "#2E86C1",
    "#E07B00",
    "#C0392B",
    "#5D6D7E",
    "#76B7B2",
    "#F2C14E",
    "#8E6C8A"
  ],
  "background": "#FFFFFF",
  "foreground": "#252423",
  "tableAccent": "#1F4E79",
  "good": "#2E86C1",
  "neutral": "#F2C14E",
  "bad": "#C0392B",
  "maximum": "#1F4E79",
  "center": "#9DC3E6",
  "minimum": "#EAF2FA",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F4E79" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1F4E79" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#252423" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1F4E79" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F4E79" } }, "fontSize": 12 }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#D6E4F0" } }, "radius": 6 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F8" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#1F4E79" } }, "fontSize": 26 }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#5D6D7E" } }, "fontSize": 11 }],
        "background": [{ "show": true, "color": { "solid": { "color": "#EAF2FA" } } }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#1F4E79" } }, "textSize": 10 }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFF4E0" } } }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#1F4E79" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#1F4E79" } } }],
        "rowHeaders": [{ "fontColor": { "solid": { "color": "#1F4E79" } } }]
      }
    }
  }
}
